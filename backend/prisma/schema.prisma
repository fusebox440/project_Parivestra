datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Brand {
  id          String     @id @default(cuid())
  name        String
  website     String
  competitors String[]
  campaigns   Campaign[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Campaign {
  id                  String        @id @default(cuid())
  brandId             String
  brand               Brand         @relation(fields: [brandId], references: [id])
  name                String
  briefText           String
  briefUrl            String?
  platforms           String[]
  startDate           DateTime
  endDate             DateTime
  status              CampaignStatus @default(DRAFT)
  keywordsMustMention String[]
  keywordsForbidden   String[]
  requiredAspectRatio String
  minDurationSecs     Int
  maxDurationSecs     Int
  deliverables        Deliverable[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([brandId, status])
}

model Creator {
  id              String        @id @default(cuid())
  name            String
  phone           String        @unique
  email           String?
  instagramHandle String?
  youtubeHandle   String?
  deliverables    Deliverable[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([phone])
}

model Deliverable {
  id          String              @id @default(cuid())
  campaignId  String
  campaign    Campaign            @relation(fields: [campaignId], references: [id])
  creatorId   String
  creator     Creator             @relation(fields: [creatorId], references: [id])
  platform    Platform
  format      Format
  dueDate     DateTime
  status      DeliverableStatus   @default(PENDING)
  submissions VideoSubmission[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([campaignId, creatorId, status])
}

model VideoSubmission {
  id                 String              @id @default(cuid())
  deliverableId      String
  deliverable        Deliverable         @relation(fields: [deliverableId], references: [id])
  videoUrl           String
  receivedAt         DateTime
  source             SubmissionSource
  rawWhatsappPayload Json?
  status             SubmissionStatus    @default(QUEUED)
  qcResult           QCResult?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([deliverableId, status])
}

model QCResult {
  id              String           @id @default(cuid())
  submissionId    String           @unique
  submission      VideoSubmission  @relation(fields: [submissionId], references: [id])
  qcScore         Float
  goodnessScore   Float
  decision        Decision
  flags           Json
  hardFailReasons String[]
  processingTimeMs Int
  apiCostInr      Float
  processedAt     DateTime
  humanReview     HumanReviewQueue?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model HumanReviewQueue {
  id            String        @id @default(cuid())
  qcResultId    String        @unique
  qcResult      QCResult      @relation(fields: [qcResultId], references: [id])
  assignedTo    String?
  status        ReviewStatus  @default(PENDING)
  reviewerNotes String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  metadata   Json
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
  DRAFT
}

enum Platform {
  INSTAGRAM
  YOUTUBE
  BOTH
}

enum Format {
  REEL
  POST
  STORY
  VIDEO
  SHORTS
}

enum DeliverableStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum SubmissionSource {
  WHATSAPP
  UPLOAD
}

enum SubmissionStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum Decision {
  APPROVED
  REJECTED
  HUMAN_REVIEW
}

enum ReviewStatus {
  PENDING
  IN_REVIEW
  RESOLVED
}
